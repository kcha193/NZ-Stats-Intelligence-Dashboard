# syntax=docker/dockerfile:1
# The trusted publisher: exports a snapshot from the database, builds the static site and deploys it with the Netlify
# CLI when the data has changed. Runs on the same host as the database; never on Netlify. See docs/netlify-deployment.md.
FROM node:22-slim AS node

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 TZ=Pacific/Auckland \
    NZSTATS_DATA_DIR=/data NZSTATS_SOURCES_FILE=/app/config/sources.toml NZSTATS_REPO_ROOT=/app \
    NPM_CONFIG_UPDATE_NOTIFIER=false NETLIFY_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
# Node 22 is the Netlify CLI's minimum; copy it from the official image rather than installing from a script.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install -g netlify-cli@27.11.2 \
 && useradd --system --uid 10001 --create-home nzstats && mkdir /work /data && chown nzstats /work /data

WORKDIR /app
COPY backend/pyproject.toml backend/
COPY backend/src backend/src
RUN pip install ./backend
COPY config /app/config
COPY frontend/package.json frontend/package-lock.json frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY frontend frontend
COPY scripts scripts
COPY netlify.toml netlify.toml
RUN chown -R nzstats /app/frontend /app/scripts
USER nzstats
VOLUME /work
ENTRYPOINT ["bash", "/app/scripts/publisher_loop.sh"]
