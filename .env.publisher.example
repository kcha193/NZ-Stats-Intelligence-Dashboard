# Copy to .env.publisher (git-ignored). Treat NETLIFY_AUTH_TOKEN like a password: anyone who has it can change the site.
# Use a token from a dedicated Netlify account or team that owns only this site.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Canonical public address, no trailing slash. Used for canonical URLs, the sitemap, share links and the live check.
PUBLISH_SITE_URL=https://your-site.netlify.app

# Nothing is deployed until this is 1. With 0 every run builds and validates the site, then stops.
PUBLISH_ENABLED=0
# 1 = deploy to a Netlify draft URL (not the public site) instead of production. Use it for the first check.
PUBLISH_DRAFT=0
# How often to look for new data. New verified data is deployed at once; other changes (a calendar refresh, say)
# wait at least this many hours after the last deploy, because each production deploy costs hosting credits.
PUBLISH_INTERVAL_MINUTES=60
PUBLISH_MIN_INTERVAL_HOURS=24
